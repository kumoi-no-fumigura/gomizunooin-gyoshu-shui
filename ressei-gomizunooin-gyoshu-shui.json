   "seq": "2",
   "text": "あらたまる春のしらべにかよふらし泉のこゑも松のひびきも",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "こほり解く汀のなみにうちそへて梅が香よする池のはるかぜ",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "さくらにも今ぞうつさむ朝な朝な色そふ梅のはなのはるかぜ",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "玉すだれもり入る風の梅が香はおもふに怪しいづくなるらむ",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "咲くかたをさして〓へよ海士小舟初瀨のさとににほふ梅が香",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ちりもせじ花より先にうぐひすの聲の色香にそむるこころは",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "更けゆけばおとのみさえて川水のすめるともなき春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "春をへてみるまよひまで花の陰にたつ事やすき物とやは見む",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "ゆく春も過ぎがてに見よ藤浪にいまたちこゆる花はあらじを",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "咲く花のかずさへそひて紅のいろもことしはふかみぐさかな",
   "kana": "",
   "speaker": "-",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "照し見よ春日に消えぬ霜もあらじ野邊の若菜のつみはありとも",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "月はなほめぐらぬかたに影すむやつづく垣根に咲ける卯の花",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "雪にまた降りこめられぬ卯のはなの垣根にあまる小野の山里",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "はつごゑはまだしのび音の時鳥卯月はおのがときならずとも",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "聞きそめて飽かぬ野中のほととぎす見おくる程ぞ空に久しき",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "ふるさとの軒端に匂ふたちばなや昔しのぶのつゆをそふらむ",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "てりそはむ紅葉は知らず秋風も月のかつらは待たぬすずしさ",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "誰が秋か露のほかなる鳴く鹿もまがきの蟲もたへぬゆふべに",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "ゆふぐれの秋はなみだも色になる野澤の水にながれそふまで",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "女郞花たれ露わけて花の色のなみだにむせぶあはれ知るらむ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "月ぞなほ影もとどめぬ吉野川はなはせかれしたきついはねに",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "蜑小舟みやこに〓げよ和田の原八十島かけておもふつきかげ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "ゆく船にゆふべあかつき見るつきも波路やかはるあきの浦人",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "暮れぬ間は八重にかさなる雨雲も思ふこよひの月なへだてそ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "白妙の雲にまがへてきりぎりすいたくな侘びそすめる月かげ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "きりぎりす長き夜あかですむ影も今やまがきの月に鳴くらむ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "山風のたたくゆふべは聞きすてて音なき月にあくるしばの戶",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "秋風に又やまかするさだめなく時雨に染めしこころ木の葉も",
   "kana": "",
   "speaker": "新",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "逢はざりしうき年月を今さらの夜をへだてむと思ふわりなさ",
   "kana": "",
   "speaker": "-",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "跡もなく木の葉のうづむ山よりもわが迷ふ戀の道しるべせよ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ながめてもなぐさむかたぞなかりける戀ふる淚にくもる月影",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "道たゆる宿の淺茅のあき風をまくずにかへすころとだに知れ",
   "kana": "",
   "speaker": "-",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ほに出でてみだれむすゑの露はうしつひに尾花がもとの心も",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "今宵だによし思ひ知れ濡れてこし萩散る小野の露のかごとは",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "山深くものにまぎれぬすみかにも住める心のしづかならずば",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "おもひやれ夜をへて馴るるから泊夢をば見する波のあはれを",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "漕ぎ出でて明日の波路もこととへばこよひの月はみつの泊を",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "うつせなほ竹の園生のあととめて老いぬる松の庭のをしへを",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "嶺に生ふる種も知らじな八千代へむ御垣の松の春のひとしほ",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "さやけしな驚もかもめも白波のよするみぎはにうつる日影は",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "はらへども後より生ふる庭草をおもへば野邊は繁らざりけり",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "なにごとをなげきの杜のしげからむ今いくほどの老の寐覺に",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "世をなげく涙がちなるたもとには曇るばかりの月もかなしき",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "いくめぐり幾代の秋の空の月くもりなき世のひかり見すらむ",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "月よみの神のめぐみや露ふかきこよひの秋のひかり添ふらむ",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "月はなほ神代のかがみかけまくもかしこき影をいまも殘して",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "散りうせぬためしと聞けば古き世にかへるを松の言の葉の道",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "おきの海のあらきなみ風しづかにて都のみなみ宮つくるなり",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "たのむぞよみもすそ川のすゑの世の數にはわれももれぬ惠を",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "八百よろづ神もさこそは守るらめ照る日の本の國つみやこを",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "あかずとや神もうくらむ色も香もふかきこころの花の手向を",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "耳に聞き目に見ることのひとつだに法の外なる物やなからむ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "世の中の彼のさわずらいつまでの身の浮舟ぞらもあらばあれ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "心もてひらくるはなは梅が香にとはばや人によしいはずとも",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "一枝をささげてしめす花の色を知る人もなしよし知らずとも",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "山人はさびしさいかにしかなきておくしもしろし岡の邊の松",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "大和路を絕えず通ひしをりのみやまづくみてみむ井手の玉水",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "うしやうし花匂ふえに風かよひちりきて人のこととひはせず",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "幾夜をへ月も見るべくりちの歌くりかへし歌ひ猶かげもよし",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "ことさらの千代のはじめや大和歌くりかへし歌ひ猶仰ぐらし",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "島のこそくはるれさかなみよしばし世皆かざれるはくそこのまし",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "この春にせめておどろく身ともがな恥おほしてふ命ながさを",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "老の波たちゐくるしきこよろぎのいそがるるこそわが思ふ道",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "のどけしな風もうごかぬいはくらの山も花咲く春のこころは",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "浦の名に聞くは遙けきみちのくの花は軒端にちかのしほがま",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "藤波のなみに思はばかひもあらじ月にさそはむ秋のはなぞの",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "うそといふ鳥やとまらむわすれ草おふる花ぞの秋やくれなむ·",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "見よや見よ都のふじのそら晴れて月もうへなき秋のひかりを",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "一枝はわきてぞ見ゆるうす紅葉きみが言葉のいろそへしより",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "おもひあればなぐさめかねつ武藏野に姨捨山の月やすむらむ",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "いしにかへる松のかもめは聲さえていはゐの海にのこる潮風",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "手にもてる扇の風は吹かずとも繪にかくたつよ雨降らすらむ",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "今よりは雪もてはやす言の葉もみかりの竹のよよにつもらむ",
   "kana": "",
   "speaker": "新",
   "page": 166,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "松の葉のちりうせぬ世のためしには空にたつみのははき星哉·",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "名にしおはば花たちばなはそれながら昔ばかりの匂やはある",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "あることはわが松山のあだにのみ幾年なみの越えむとすらむ",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "よしやただありしながらも世の中を思ひ離れむ程ぞ知らるる",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "思ふ事なきだに背く世の中にあはれ捨ててもをしからぬ身を",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "花鳥の色音もなにか老が身はゆきよりほかのともならばこそ",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "つくからに千年の坂も踏みわけて君が越ゆべき道しるべせむ",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "高砂の尾上ならでもほととぎす待つはいくよの物とかは知る",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "おもへただ應化の外もなすことのあらばまことの佛ならじを",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "池水の岸根の松に千代ふべきところを得てや田鶴も住むらむ",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "鶴かめも知らじな君がよろづ代の霜のしらぎく殘る日かずは",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "なにごとも夢の外なる世はなしと思ひし事もかきまぎれつつ",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "むかひめて唯うながらの面影もひと言をだにかはうねぞうき",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "あけ暮にありしながらの事わざも目の前さらず見る心地して",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "みぬ世まで思ひ殘さずとばかりのこの一ことを何にかへまし",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "たれも思へ聞きても見ても驚かぬ世をいつまでの空賴みして",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "ふたたびほうまれ達はむち頼まれぬこの世の夢の見かなしき",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "かかる時ぬれぬ袖やはありそ海のはまの眞砂のあめのした人",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "をりをりに思ひいづれば草も木も見るに淚のたねならぬかは",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "あはれなり鳥部野に立つゆふ煙それさ",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "世のあはれ知るかしそ思ふ時鳥おのがるつきの空に鳴く音は",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "老のやまかりする人もなきものをおちくるししの哀なるかな",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "人よしれいへどさらなるわが思こころ餘りてことば足らずと",
   "kana": "",
   "speaker": "ばかなし末とほくみえしたか根も花のしら雲",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "しなばやなもよほし草よ世の中の目にも耳にもあまる事こそ",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "いかにせむいへばまことの道ならゐ道の願もたちがたき世を",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "曲木にやなぎのいとをよりかけてすぐなる道を風にとはばや",
   "kana": "",
   "speaker": "又一本此御歌は延寶巳年世中あやしき事の多く",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "章原やしげらばしげれおのかまましても道ある世とは思はず",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "賢きは捨てられぬ身をすつる世に世に捨てられてすてぬ身ぞうき",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "年月をよそにのみ見て過ぎしかどきのふの木こそ身の類なれ",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "思ふ事なきだに背く世の中にあはれ捨てても惜しからぬかは",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "うしとてもうからずとてもよしやただ五十の後の幾程の世は",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "いとふべきことわりまでは知る人のすつるに難き世の習かな",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "世の中はあしまの蟹のあしまどひ橫にゆくこそ道のみちなれ",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "みな人は上に曰がつく橫にゆく產間のかにのあはれなる世や",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "古をかきおく筆のあともうしさらずばくだる世とも知らじを",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "ひらけなほ文の道こそいにしへに歸らむあとは今ものこさめ",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "あかざりし昔のことをかきつくる硯のみづはなみだなりけり",
   "kana": "",
   "speaker": "又一本此御歌初はのこらめと被遊有詔諸公",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "生ひそむる年よりしるり富竹の本の世ながくならむものとは",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "あぢきなや心のうちのしるべにて尋ねかねたる鵙のくさぐき",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "いたづらになすなよ心なほき木に曲れる枝はありとゆるして",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "人もこれ草葉もしげし野もひろし摘む菜となれば雨も少なし",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "更けわたる月に誘ひてすみのばる河曾たかき夜半ののどける",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "かげやどす淺茅が露のみだれきて野風にくもる月もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "むかし見し野原は里となりにけり數そふ人のかずは知らねど",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "千代の色ものどけき空にあらはれて春の野しるき神無月かな",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "なつふかみしげる野もせの露に見よ麻もよもぎももれぬ惠を",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "天が下隱るる事のなからめやきてしかりぎぬひるよしもがな",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "思ふぞよわれもむかしは九重のしのばれぬべき道もこれまで",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "うつすともえやはおよばぬ嶺の松しろきをのちの面影にせよ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "いとふとて皆人ごとに身を捨てば山やなかなか愛世ならまし",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "あさがほのもろきも千代の白菊もおなじ枯野の霜のあはれさ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "うき草のすゑより水の春風や世に吹きそめてのどけかるらむ",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "さやけしなかひこを出づる鳥の音に山しもわかずあくる光は",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "百敷やなれしわが世もおもふにはいくほどならぬ松の木高さ",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "いつはりのことのみおほき玉章をひきかへしても恨みつる哉",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "夕暮はいとどさびしきいろそへて風にみだるる庭のもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "明日はまた木かげにぞ見むしばしなほこの夕風に殘る紅葉も",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "月もなほ空にやすらふ槇の戶の明けぬといひし影はとまらず",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "もみぢ葉をさそひつくして吹く音は木木にさびしき夕嵐かな",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "いかにせむつれなきよりも中中に逢ひ見てのちの今朝の面影",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "ゆふあらし高根のもみぢさそひきて錦をしける深山邊のさと",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "かきくれぬわかれし今朝の面影の立ちはなれぬも落つる淚に",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "散りしきし庭のもみぢ葉吹きたてて錦と見する夕あらしかな",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "逢はぬまの歎はものか別れこし今朝のつらさに思ひくらべて",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "吹きつくす木の葉が上は音もなしゆふべの風も松にのこして",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "わりなしやあはぬ恨の涙にもくらべぐるしき今朝のたもとは",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "秋の色のかたみにのこすもみぢ葉をつれなくさそふ夕嵐かな",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "みちしばの露の玉のを消えねただ今朝のわかれに何殘るらむ",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "散りしくをまた吹きたてて夕風の紅葉を庭にのこさぬもうし",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "天つ空くもりなきまで照る月のうつれる水のそこもにごらず",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "雲居より澤邊にかよふ聲すなり子をおもふ鶴も思はるるかな",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "ゆきわかれ山田もる男ぞいとまなき賤機帶のとけし夜の間も",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "春ごとに梅よりつぎて咲く花のこずゑ數多のをりふしぞなき",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "蘆間より友したふこゑぞ哀なるおのれのみやはあさる雁がね",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "雲はらふあらしにつれて百舟も千舟もなみのあはづにぞよる",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "露しぐれもる山とほく過ぎきつつ夕日のわたる勢多のなが橋",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "眞帆ひきて矢橋にかへる舟はいま打出のはまのあとのおひ風",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "思ふそのあかつき近きはじめぞとまづ聞く三井の入相のかね",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "夜の雨におとをゆづりて春風をよそになたてそからさきの松",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "雪晴るる比良の高嶺のゆふぐれに花のさかりを過ぐる春かぜ",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "石山やにほのうみ照る月かげは明石も須磨もほかならぬかな",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "嶺あまた越えて越路にまづ近き堅田になびき落つるかりがね",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "蟬の羽の夜のころもは薄けれどうつり香よりも匂ひぬるかな",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "千代をへて底まで澄める池水にふかくもうつる花のいろかな",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "小夜衣こは世にしるきにほひかな菖蒲をむすぶ草のまくらを",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "かりそめに軒のあやめも時しあれば五月雨の空に匂ことなる",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "たづねつる花のあたりになりにけり匂ふにしるし春のやま風",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "吉野山やまより深きものやあると心にとへばこころなりけり",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "花すすきほのかに聞けば秋霧のたち野のすゑに牡鹿鳴くなり",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "ねても又さめてもつらき世の中にあるかひもなきわが住居哉",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "うしといひ世に住みながら露の身の消えてはかなき名をや流さむ",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "とらば手にたまりもやらぬ秋の夜の草葉の露にやどるつき影",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "うきときの心はやがてそのままに世を厭はばや思ひかへさむ",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "たつままに霞のころもき重ねて花のひもをばいつか解くべし",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "みなかみや吉野の山もつづくらむ花のいかだをながすはる風",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "うまれきて世をすみぞめの袖ならば心を染めよ法のしるしに",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "ひ·つ·しよの浪に任せてゆく舟のよるべも知らぬ心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "と·さ·なからに心ぼそくも聞ゆるは山よりおくのいりあひのかね",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "ぬ櫻また咲きそめしやま櫻こずゑにあふはきさらぎのはな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "つまでか老に心のわかからむ去年をことしと思ふ身にして",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "945304",
   "form": "短歌",
   "genre": ""
  }
 ],
